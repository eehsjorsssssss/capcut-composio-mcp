# URL of your CapCut-compatible REST API.
# For the community CapCutAPI project this is commonly http://127.0.0.1:9001
CAPCUT_BASE_URL=http://127.0.0.1:9001

# Optional CapCut API authentication.
CAPCUT_API_KEY=
CAPCUT_AUTH_HEADER=Authorization
CAPCUT_AUTH_PREFIX=Bearer

# Protect the public MCP endpoint at the Composio layer.
# Composio can register this server with an API_KEY auth scheme.
BRIDGE_API_KEY=change-me

# Server
HOST=0.0.0.0
PORT=8000
ALLOWED_HOSTS=*
ALLOWED_ORIGINS=*

# Optional endpoint overrides
CAPCUT_HEALTH_PATH=/health
CAPCUT_CREATE_DRAFT_PATH=/create_draft
CAPCUT_ADD_VIDEO_PATH=/add_video
CAPCUT_ADD_TEXT_PATH=/add_text
CAPCUT_ADD_KEYFRAME_PATH=/add_video_keyframe
CAPCUT_SAVE_DRAFT_PATH=/save_draft
